{
  "expo": {
    "name": "Anusha Trade",
    "slug": "investapp",
    "scheme": "investapp",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/brand-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anushamilktrades",
      "minSdkVersion": 24,
      "versionCode": 10,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/brand-logo.png"
    },
    "extra": {
      "authApiBaseUrl": "https://api.anushatrade.com",
      "useMockApi": false,
      "enableTestingOtp": false,
      "testingOtpCode": "123456",
      "router": {},
      "eas": {
        "projectId": "11894c67-e958-46f6-8157-86e3e6763b48"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Anusha Trade to use Face ID for secure login."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Anusha Trade to access your photo library to select KYC documents.",
          "cameraPermission": "Allow Anusha Trade to access your camera to take photos of KYC documents."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ]
  }
}